{
  // Tarefas do Bloom Agent — Terminal > Run Task... (ou Ctrl+Shift+P)
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Bloom: rodar todos os testes",
      "type": "shell",
      "command": "python",
      "args": ["tests/run_all.py"],
      "group": { "kind": "test", "isDefault": true },
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true },
      "problemMatcher": []
    },
    {
      "label": "Bloom: validação leve (sem testes)",
      "type": "shell",
      "command": "python",
      "args": ["tools/project_cli.py", "validate"],
      "problemMatcher": []
    }
  ]
}
